mod = {
    name: "Buyout & Merger Cooldown",
    description: "Reduces the cooldown between company buyouts and mergers.",
    author: "MrJoery",
    version: "1.0.2",

    step: fun () {
        if global.daysfromuy > 7 {
            global.daysfromuy = 7
        }
    }
}

return mod
